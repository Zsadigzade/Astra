# Copy to .env (git-ignored) and fill in. Never commit real values.
PAYMENTS_MODE=simulated
MASUMI_PAYMENT_URL=http://localhost:3001/api/v1
MASUMI_API_KEY=
APIFY_TOKEN=
ELEVENLABS_API_KEY=

# --- added with skeleton (feat/ziya-skeleton) ---
LLM_MODE=mock                 # codex = subscription Max via local CLI; mock = scripted
SELLER_LLM_MODE=mock          # codex = subscription Viktor using the same CLI; Act 2 stays scripted
ANSWER_MODE=auto             # any non-rental request: auto = on when Max or Viktor uses codex; codex = on; off = rentals only
ANSWER_SEARCH=on           # answers may use live web search (Codex --search); off = own knowledge only
ANSWER_SCOUT=on             # Viktor starts searching while he haggles (so he can mention real finds) and reuses it as the delivery
ANSWER_PREVIEWS=on          # read each finding's page for its preview photo (public https pages only; many shops block this)
ANSWER_TIMEOUT_SECONDS=120   # an answer with web search takes longer than a negotiation turn
CODEX_COMMAND=codex           # installed Codex CLI; authenticate with codex login (ChatGPT)
CODEX_MODEL=                  # blank uses the CLI default available to your subscription
CODEX_TIMEOUT_SECONDS=30      # per-round deadline, then visibly scripted fallback
CODEX_MAX_CONCURRENT=2        # simultaneous CLI turns per buyer/seller service process
CODEX_QUEUE_TIMEOUT_SECONDS=5 # queue wait also consumes the per-round deadline
CODEX_FAILURE_THRESHOLD=3    # consecutive CLI failures before local cooldown
CODEX_COOLDOWN_SECONDS=15    # after cooldown, allow one recovery turn; not a quota-reset estimate
GUARD_CAP=10                  # tADA hard cap per deal, enforced in code
GUARD_APPROVAL_OVER=8         # above this, dashboard approval needed
SELLER_URL=http://localhost:8001
SELLER_FLOOR=7                # Viktor's lowest price; 9 forces the approval path
APIFY_MODE=sample             # sample | apify (live, cached fallback) | cached (saved real data only)
# apify attempts a paid scrape on every rental delivery, even when a matching cache exists.
# Local live profile: LLM_MODE=codex, SELLER_LLM_MODE=codex, APIFY_MODE=apify,
# TTS_MODE=elevenlabs; keep PAYMENTS_MODE=simulated. Restart after current deals finish.
APIFY_ACTOR_ID=swerve/sreality-scraper
APIFY_MAX_ITEMS=200           # cap Praha 7 results; fewer than requested valid matches fails explicitly
APIFY_TIMEOUT_SECONDS=90
APIFY_CACHE_PATH=data/flats-apify.json
APIFY_CACHE_MAX_AGE_SECONDS=86400  # reject saved rentals older than one day
APIFY_ALLOW_STALE_CACHE=0         # 1 only for explicitly labelled offline demo; never hides age
TTS_MODE=off                  # off | elevenlabs
VOICE_MAX=                    # ElevenLabs voice id for Max
VOICE_VIKTOR=                 # ElevenLabs voice id for Viktor
TTS_MODEL=eleven_flash_v2_5
TTS_TIMEOUT_SECONDS=12
TTS_CACHE_MAX_FILES=512       # admission limit; published clips retained for active deals/replay
TTS_CACHE_MAX_BYTES=134217728 # 128 MiB; new uncached lines become text-only at capacity
CRASH_AFTER_LOCK=             # 1 = STAGED Act 3, buyer kills itself right after escrow lock

# --- Masumi mode (PAYMENTS_MODE=masumi) ---
MASUMI_NETWORK=Preprod
MASUMI_AGENT_ID=              # Viktor's agentIdentifier from the Masumi registry (Dynamic pricing)
SELLER_VKEY=                  # Viktor's selling wallet vkey (56 hex), from the admin UI
MASUMI_POLL_SECONDS=5
MASUMI_PAY_BY_MINUTES=20
MASUMI_SUBMIT_MINUTES=40

# --- Subscription-only model access ---
# No OpenAI API keys will be available. Run codex login on each demo laptop, then
# scripts/llm_check.py from backend/ and set LLM_MODE=codex after the check passes.
# Subscription credentials stay in Codex's own store; never copy them into .env.

# Sokosumi marketplace (agents + jobs only, no payments). Unused until after 01:00.
SOKOSUMI_API_KEY=

# --- Masumi node (Railway) side, not read by Haggle ---
# Paste into the Railway template's variables. ADMIN_KEY there = MASUMI_API_KEY above.
# Replace the template's pre-filled ADMIN_KEY and ENCRYPTION_KEY; never keep its defaults.
# MASUMI_NODE_ENCRYPTION_KEY=   # Railway ENCRYPTION_KEY, 32+ random chars
# BLOCKFROST_API_KEY_PREPROD=   # Blockfrost project key for Preprod (not Mainnet)

# Extra browser origins allowed to call the buyer (comma-separated). Any localhost port is always allowed.
CORS_ORIGINS=

# --- Local production hardening ---
# STRICT_LIVE=1 = live recording profile: services refuse to start unless Max/Viktor use Codex, data is live Apify
# (no stale cache) and voice is ElevenLabs; failed live turns surface as errors (seller HTTP 503),
# never scripted/cached fallbacks. Max's opening and guard notices remain code-generated.
# Payments may stay SIMULATED. This does not configure public hosting. 0 = development profile.
STRICT_LIVE=0
# Shared access tokens (long random values, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))").
# Empty = open service (local development only).
# API_TOKEN: every buyer endpoint except GET /health requires header X-API-Token or Authorization: Bearer;
#   /events and /audio/* also accept ?token= (EventSource/<audio> cannot send headers).
#   npm start passes it to the dashboard as VITE_API_TOKEN; it is then visible to anyone who can load
#   the dashboard, so keep the dashboard on this machine and never commit a build made with it.
API_TOKEN=
# SELLER_API_TOKEN: every seller endpoint except /health and /availability requires it; the buyer sends it.
SELLER_API_TOKEN=
# Per-client limit on POST /tasks and POST /requests/parse (requests per minute, each counted separately); 0 disables.
RATE_LIMIT_PER_MINUTE=30
# Seller jobs, start acknowledgements and Viktor's agreements survive a seller restart in this SQLite file
# (default backend/data/seller.db). Use a separate file per payment mode, like LEDGER_PATH.
# SELLER_STORE_PATH=

# --- Optional tunables (defaults shown; usually leave alone) ---
# MAX_ROUNDS=6                # negotiation rounds before Max walks away (dashboard can lower it at runtime)
# POLL_SECONDS=1              # buyer polling interval for seller job status
# JOB_SECONDS=2               # simulated seller work time before a delivery is ready
# SELLER_OPENING_ASK=18       # Viktor's opening price (tADA)
# AUDIO_DIR=                  # where generated voice clips are stored (default backend/data/audio)
# LEDGER_PATH=                # buyer SQLite ledger (default backend/data/buyer.db); use a separate file per payment mode
