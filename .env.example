# Copy to .env (git-ignored) and fill in. Never commit real values.
PAYMENTS_MODE=simulated
MASUMI_PAYMENT_URL=http://localhost:3001/api/v1
MASUMI_API_KEY=
APIFY_TOKEN=
ELEVENLABS_API_KEY=

# --- added with skeleton (feat/ziya-skeleton) ---
LLM_MODE=mock                 # codex = subscription Max via local CLI; mock = scripted
SELLER_LLM_MODE=mock          # codex = subscription Viktor using the same CLI; Act 2 stays scripted
CODEX_COMMAND=codex           # installed Codex CLI; authenticate with codex login (ChatGPT)
CODEX_MODEL=                  # blank uses the CLI default available to your subscription
CODEX_TIMEOUT_SECONDS=30      # per-round deadline, then visibly scripted fallback
GUARD_CAP=10                  # tADA hard cap per deal, enforced in code
GUARD_APPROVAL_OVER=8         # above this, dashboard approval needed
SELLER_URL=http://localhost:8001
SELLER_FLOOR=7                # Viktor's lowest price; 9 forces the approval path
APIFY_MODE=sample             # sample | apify (live, cached fallback) | cached (saved real data only)
APIFY_ACTOR_ID=swerve/sreality-scraper
APIFY_MAX_ITEMS=200           # cap Praha 7 results; fewer than requested valid matches fails explicitly
APIFY_TIMEOUT_SECONDS=90
APIFY_CACHE_PATH=data/flats-apify.json
TTS_MODE=off                  # off | elevenlabs
VOICE_MAX=                    # ElevenLabs voice id for Max
VOICE_VIKTOR=                 # ElevenLabs voice id for Viktor
TTS_MODEL=eleven_flash_v2_5
TTS_TIMEOUT_SECONDS=12
CRASH_AFTER_LOCK=             # 1 = STAGED Act 3, buyer kills itself right after escrow lock

# --- Masumi mode (PAYMENTS_MODE=masumi) ---
MASUMI_NETWORK=Preprod
MASUMI_AGENT_ID=              # Viktor's agentIdentifier from the Masumi registry (Dynamic pricing)
SELLER_VKEY=                  # Viktor's selling wallet vkey (56 hex), from the admin UI
MASUMI_POLL_SECONDS=5
MASUMI_PAY_BY_MINUTES=20
MASUMI_SUBMIT_MINUTES=40

# --- Subscription-only model access ---
# No OpenAI API keys will be available. Run codex login on each demo laptop, then
# scripts/llm_check.py from backend/ and set LLM_MODE=codex after the check passes.
# Subscription credentials stay in Codex's own store; never copy them into .env.

# Sokosumi marketplace (agents + jobs only, no payments). Unused until after 01:00.
SOKOSUMI_API_KEY=

# --- Masumi node (Railway) side, not read by Haggle ---
# Paste into the Railway template's variables. ADMIN_KEY there = MASUMI_API_KEY above.
# Replace the template's pre-filled ADMIN_KEY and ENCRYPTION_KEY; never keep its defaults.
# MASUMI_NODE_ENCRYPTION_KEY=   # Railway ENCRYPTION_KEY, 32+ random chars
# BLOCKFROST_API_KEY_PREPROD=   # Blockfrost project key for Preprod (not Mainnet)

# Extra browser origins allowed to call the buyer (comma-separated). Any localhost port is always allowed.
CORS_ORIGINS=

# --- Optional tunables (defaults shown; usually leave alone) ---
# MAX_ROUNDS=6                # negotiation rounds before Max walks away (dashboard can lower it at runtime)
# POLL_SECONDS=1              # buyer polling interval for seller job status
# JOB_SECONDS=2               # simulated seller work time before a delivery is ready
# SELLER_OPENING_ASK=18       # Viktor's opening price (tADA)
# AUDIO_DIR=                  # where generated voice clips are stored (default backend/data/audio)
# LEDGER_PATH=                # buyer SQLite ledger (default backend/data/buyer.db); use a separate file per payment mode
